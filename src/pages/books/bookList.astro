---
import Layout from "../../layout/BaseLayout.astro";
import { getCollection } from "astro:content";
import type { BookI } from "../../BookInterface";

const cBooks = await getCollection("mkBooks");

import BookCard from "../components/BookCard.astro";
---

<Layout>
  <div>
    <h1>BOOKS</h1>
    <p class="tt">Book List</p>
    {
      cBooks.map((book)=> {
        return (
          <div>
            Hello title: {book.data.title} 
            <a href={`/books/dynamicBooks${book.id}`}>{book.data.title}</a>                        
          </div>
        );
      })
    }
  </div>

  <style>
    .tt {
      color: blue;
    }
  </style>
</Layout>
