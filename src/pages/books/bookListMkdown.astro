---
import Layout from "../../layout/BaseLayout.astro";
import { getCollection } from "astro:content";
const cBooks = await getCollection("mkBooks");
---

<Layout>
  <div> 
    <h1>BOOKS</h1>
    <p class="tt">Book List from mkdown</p>
    {
      cBooks.map((book)=> {
        return (
          <div>
            Hello title: {book.data.title} #{book.id}#
            <a href={`/books/dynamicBooks${book.id}`}>{book.data.title}-{book.id}</a>                        
          </div>
        );
      })
    }
  </div>

  <style>
    .tt {
      color: blue;
    }
  </style>
</Layout>
