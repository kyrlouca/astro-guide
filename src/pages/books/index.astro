---

import Layout from "../../layout/BaseLayout.astro";
import { getCollection } from 'astro:content';
import type { BookI } from '../../BookInterface';
const cBooks = await getCollection('books');
import BookCard from "../../components/BookCard.astro";
---

<Layout>
  <div>
    <h1>BOOKS from json Collection</h1>
    {cBooks.length > 0 && <p class="tt">Here are sosssme great books to read!</p>}        
    {cBooks.length === 0 && <p>No books available.</p>}        
    {cBooks.map((book) => <BookCard book={book.data as BookI} />)}    
  </div>

  <style>
    .tt {
      color: blue;
    }
  </style>
</Layout>
